commit_msg_file="$1"
commit_msg="$(head -n 1 "$commit_msg_file")"

if ! echo "$commit_msg" | grep -Eq '^(build|chore|ci|docs|feat|fix|perf|refactor|revert|style|test): .+'; then
  echo "Invalid commit message."
  echo "Use: type: description"
  echo "Allowed types: build, chore, ci, docs, feat, fix, perf, refactor, revert, style, test"
  exit 1
fi
