{
  "compilerOptions": {
    "target": "ES2020",
    "jsx": "react-jsx",
    "lib": [
      "ES2020",
      "ES2022.Intl",
      "DOM",
      "DOM.Iterable"
    ],
    "moduleDetection": "force",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "paths": {
      // Pin React types to this app's own @types/react 18. Libraries such as react-router are shared
      // with the React 19 landing page in the pnpm store and would otherwise pick up @types/react 19.
      "react": ["./node_modules/@types/react"],
      "react/*": ["./node_modules/@types/react/*"],
      "react-dom": ["./node_modules/@types/react-dom"],
      "react-dom/*": ["./node_modules/@types/react-dom/*"],
      // Same for zod: @hookform/resolvers 3 resolves its zod types from the store, where the
      // landing page's zod 4 now also lives.
      "zod": ["./node_modules/zod"],
      "@/components/shadcn/*": [
        "../../packages/reusables/src/components/shadcn/*"
      ],
      "@/lib/utils": [
        "../../packages/reusables/src/lib/utils"
      ],
      "@truckmoov/reusables/components/*": [
        "../../packages/reusables/src/components/*"
      ],
      "@truckmoov/reusables/hooks/*": [
        "../../packages/reusables/src/hooks/*"
      ],
      "@truckmoov/reusables/lib/*": [
        "../../packages/reusables/src/lib/*"
      ],
      "@/*": [
        "./src/*"
      ],
      "@truckmoov/api/lib/*": [
        "../../packages/api/src/lib/*.ts"
      ],
      "@truckmoov/api/*": [
        "../../packages/api/src/*/index.ts"
      ]
    },
    "types": [
      "vitest/globals"
    ],
    "allowImportingTsExtensions": true,
    "strict": false,
    "noFallthroughCasesInSwitch": false,
    "noImplicitAny": false,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noEmit": true,
    "isolatedModules": true,
    "skipLibCheck": true
  },
  "include": [
    "src"
  ]
}
