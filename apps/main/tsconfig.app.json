{
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "lib": [
      "ES2020",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleDetection": "force",
    "moduleResolution": "bundler",
    "noEmit": true,
    "noFallthroughCasesInSwitch": false,
    "noImplicitAny": false,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "paths": {
      "@/components/shadcn/*": [
        "../../packages/reusables/src/components/shadcn/*"
      ],
      "@/lib/utils": [
        "../../packages/reusables/src/lib/utils"
      ],
      "@truckmoov/reusables/components/*": [
        "../../packages/reusables/src/components/*"
      ],
      "@/*": [
        "./src/*"
      ],
      "@truckmoov/api/lib/token": [
        "../../packages/api/src/lib/token.ts"
      ],
      "@truckmoov/api/lib/axios-instance": [
        "../../packages/api/src/lib/axios-instance.ts"
      ],
      "@truckmoov/api/lib/query-client": [
        "../../packages/api/src/lib/query-client.ts"
      ],
      "@truckmoov/api/lib/types": [
        "../../packages/api/src/lib/types.ts"
      ],
      "@truckmoov/api/auth": [
        "../../packages/api/src/auth/index.ts"
      ]
    },
    "skipLibCheck": true,
    "strict": false,
    "target": "ES2020",
    "types": [
      "vitest/globals"
    ],
    "useDefineForClassFields": true
  },
  "include": [
    "src"
  ]
}
