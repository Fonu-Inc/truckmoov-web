{
  "compilerOptions": {
    "paths": {
      "@/components/shadcn/*": [
        "../../packages/reusables/src/components/shadcn/*"
      ],
      "@/lib/utils": [
        "../../packages/reusables/src/lib/utils"
      ],
      "@/*": [
        "./src/*"
      ]
    },
    "allowJs": true,
    "strictNullChecks": false,
    "noImplicitAny": false,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "skipLibCheck": true
  },
  "references": [
    {
      "path": "./tsconfig.app.json"
    },
    {
      "path": "./tsconfig.node.json"
    }
  ],
  "files": []
}
