# Backend API (NestJS/MySQL service) — set to localhost for dev, prod URL for deployment
VITE_BACKEND_URL=https://backend.truckmoov.com/api
VITE_FONU_COMPANY_UUID=your_fonu_company_uuid
VITE_FONU_API_KEY=your_fonu_api_key
# Meta app for WhatsApp embedded signup (platform WhatsApp Setup page). Public identifiers, not secrets.
VITE_META_APP_ID=your_meta_app_id
VITE_META_CONFIG_ID=your_embedded_signup_configuration_id
